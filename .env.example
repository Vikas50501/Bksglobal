# Copy to .env on a PHP host, or add these as Environment Variables in Vercel.
# Gmail: turn on 2-Step Verification, then create an App Password (16 chars).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Where enquiries are delivered (comma-separate for more than one)
MAIL_TO=info@yourdomain.com

# Shown as the sender. Most SMTP providers require this to match SMTP_USER.
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=Website Chatbot
